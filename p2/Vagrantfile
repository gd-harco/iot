Vagrant.configure("2") do |config|
  config.vm.box = "debian/bookworm64"

  # accessing "localhost:8080" will access port 80 on the guest machine.
  # NOTE: This will enable public access to the opened port
  # config.vm.network "forwarded_port", guest: 80, host: 8080

  # Create a public network, which generally matched to bridged network.
  # Bridged networks make the machine appear as another physical device on
  # your network.
  # config.vm.network "public_network"

  config.vm.provider "virtualbox" do |vb|
    vb.gui = false
    vb.cpus = 2

    vb.memory = 4096 
  end

  config.vm.define "marobertS" do |server|
    server.vm.hostname = "marobertS"
    server.vm.network "private_network", ip: "192.168.56.110"

    server.vm.provision "install-k3s-server", type: "shell", inline: <<-SHELL
      export INSTALL_K3S_EXEC="server --write-kubeconfig-mode=644"
      wget -qO- https://get.k3s.io | sh -
      if [ $? -ne 0 ]; then
        echo "Failed to install k3s server $?"
        exit 1;
      fi
    SHELL

    server.vm.provision "k3s-apply-manifests", type: "shell", after: "install-k3s-server", privileged: false, inline: <<-SHELL 
      cd /vagrant
      kubectl apply -f namespace.yml
      kubectl apply -f app1.yml
      kubectl apply -f app2.yml
      kubectl apply -f app3.yml
      kubectl apply -f ingress.yml
    SHELL

  end
end
