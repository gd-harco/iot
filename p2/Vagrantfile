# -*- mode: ruby -*-
# vi: set ft=ruby :

=begin

=end


SERVICES = {
  'marobertS' => {
    ip: '192.168.56.110',
    # ports: { 6379 => 6379 }
  }
}

Vagrant.configure("2") do |config|

  config.vm.box = "debian/bookworm64"

  config.vm.provider "virtualbox" do |v|
    v.memory = 1024
    v.cpus = 1
  end

# Common provisionning

  config.vm.provision "shell", name: "apt-basics", inline: <<-SCRIPT
    sudo apt-get update
    sudo apt-get install curl -y
    SCRIPT

  config.vm.define "marobertS" do |server|
    server.vm.hostname = "marobertS"
    server.vm.network "private_network", ip: SERVICES['marobertS'][:ip]
    server.vm.provider "virtualbox" do |v|
      v.name = "marobertS"
    end
    server.vm.provision "shell", name: "install-k3s-Server", path:"./provisioning/ServerProvision.sh"
  end

  config.vm.provision "shell", name: "no-sudo-kubectl", inline: <<-SCRIPT
    sudo chmod 644 /etc/rancher/k3s/k3s.yaml
    SCRIPT

end

