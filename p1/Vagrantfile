# -*- mode: ruby -*-
# vi: set ft=ruby :


SERVICES = {
  'gd-harcoS' => {
    ip: '192.168.56.110',
    # ports: { 6379 => 6379 }
  },
  'gd-harcoSW' => {
    ip: '192.168.56.111',
    # ports: { 8080 => 8080 }
  }
}

Vagrant.configure("2") do |config|
  # The most common configuration options are documented and commented below.
  # For a complete reference, please see the online documentation at
  # https://docs.vagrantup.com.

  # Every Vagrant development environment requires a box. You can search for
  # boxes at https://vagrantcloud.com/search.
  config.vm.box = "debian/bookworm64"

  config.vm.provider "virtualbox" do |v|
    v.memory = 1024
    v.cpus = 1
  end

# Common provisionning

  config.vm.provision "shell", name: "apt-basics", inline: <<-SCRIPT
    sudo apt-get update
    sudo apt-get install curl -y
    SCRIPT

  config.vm.define "gd-harcoS" do |server|
    server.vm.hostname = "gd-harcoS"
    server.vm.network "private_network", ip: SERVICES['gd-harcoS'][:ip]
    server.vm.provider "virtualbox" do |v|
      v.name = "gd-harcoS"
    end
    server.vm.provision "shell", name: "install-k3s-Server", path:"./provisioning/ServerProvision.sh"
  end

  # le token s;affiche dans /var/lib/rancher/k3s/server/token. le recuper et l'exporter dans l'env du worker


  config.vm.define "gd-harcoSW" do |worker|
    worker.vm.hostname = "gd-harcoSW"
    worker.vm.network "private_network", ip: SERVICES['gd-harcoSW'][:ip]
    worker.vm.provider "virtualbox" do |v|
      v.name = "gd-harcoSW"
    end
    worker.vm.provision "shell", name: "install-k3s-Worker", path:"./provisioning/WorkerProvision.sh"
  end

end

